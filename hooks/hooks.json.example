{
  "//": [
    "AYC Skill - OPTIONAL continuous mode. This file is deliberately named",
    ".example so installing the plugin does NOT activate it. Hooks run commands on",
    "your machine with your permissions, and the skill's own rule is that hooks are",
    "shown and chosen, never installed silently.",
    "",
    "To use: copy the `hooks` block into .claude/settings.json (project) or",
    "~/.claude/settings.json (personal). ${CLAUDE_PLUGIN_ROOT} resolves inside a",
    "plugin; if you copy this into plain settings, replace it with the absolute path",
    "to the skill folder.",
    "",
    "What each one buys you is documented in references/hooks.md."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/skills/ayc-skill/scripts/recall.py\" \"session start: current branch work\" --root .ayc-skill --top 4 || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --cached 2>/dev/null | python \"${CLAUDE_PLUGIN_ROOT}/skills/ayc-skill/scripts/redact.py\" --strict >/dev/null",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run -s typecheck --if-present || true",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -d .ayc-skill && echo 'If anything changed outside a run (fix, deploy, incident, decision), capture it: ayc-skill record \"<what happened>\"' || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
